# Copy to .env.local; never commit real credentials.
INCIDENTCOURT_DATA_MODE=local
SAMPLE_MODE=false
# Existing Zetaris SQL UI origin, not the Cloud Gateway billing/account portal.
ZETARIS_BASE_URL=
ZETARIS_ORG_ID=
ZETARIS_API_KEY=
# Or use an existing account instead of a token:
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
# Optional identifier namespace with trailing dot, e.g. incidentcourt.
ZETARIS_TABLE_PREFIX=
ZETARIS_ENGINE_ID=
# Existing Meterless runtime only. No inference is sent by default.
NIGHTSHIFT_BASE_URL=http://127.0.0.1:8088/v1
NIGHTSHIFT_API_KEY=
NIGHTSHIFT_TOKEN_FILE=
# Copy an explicit hosted model ID advertised by Nightshift after its provider is configured.
# Example only; availability must be verified: nvidia/nemotron-3.5-lightning-30b-a3b
NIGHTSHIFT_MODEL=
NIGHTSHIFT_HOSTED_ONLY=1
# The pinned NVIDIA Nemotron 3/3.5 route uses non-thinking JSON responses.
NIGHTSHIFT_ENABLE_THINKING=0
# Optional bound applied to each planner/critic/explanation response.
NIGHTSHIFT_MAX_OUTPUT_TOKENS=1200
# Set to 1 only after authorizing the runtime's underlying model usage.
NIGHTSHIFT_ALLOW_INFERENCE=0
